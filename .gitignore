.DS_Store
.venv/
# Flash dumps hold each unit's IMEI and RF calibration: keep them out of git,
# track only their SHA256SUMS.
firmware/backup/*.bin

# Live memory and logs contain unit/SIM identifiers.
firmware/live/
__pycache__/

# Generated by tools/ghidra/build.sh. Both hold vendor code.
firmware/ghidra/
firmware/decompiled/
